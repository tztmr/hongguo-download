{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "红果下载",
  "version": "0.5.0",
  "identifier": "com.edking.hongguo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "node ../scripts/verify-api-sidecar.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "红果下载",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../main.py": "api/main.py",
      "../../requirements.txt": "api/requirements.txt",
      "../../core": "api/core",
      "../../endpoints": "api/endpoints",
      "resources/ai-components.schema.json": "resources/ai-components.schema.json",
      "resources/ai-components.json": "resources/ai-components.json",
      "resources/ai-components.windows.json": "resources/ai-components.windows.json"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
