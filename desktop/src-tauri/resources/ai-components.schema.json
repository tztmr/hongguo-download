{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hongguo AI component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "platform", "components"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "platform": { "type": "string", "const": "aarch64-apple-darwin" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "platform", "url", "sha256", "downloadBytes", "installedBytes", "entrypoint"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "platform": { "type": "string", "const": "aarch64-apple-darwin" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "downloadBytes": { "type": "integer", "minimum": 1 },
          "installedBytes": { "type": "integer", "minimum": 1 },
          "entrypoint": { "type": "string", "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*$" }
        }
      }
    }
  }
}
